# ---------------------------------------------------------------------------
# CardioSense .gitignore
#
# Rule of thumb:
#   - Never commit raw data (licence restrictions + size).
#   - Never commit model binaries (size; they live in Drive / Releases).
#   - DO commit results (metrics JSON, CSV tables, figures) — these are the
#     evidence for the report and the paper, and they are small.
# ---------------------------------------------------------------------------

# --- Raw / derived datasets ------------------------------------------------
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md

# --- Model artifacts -------------------------------------------------------
models/**
!models/**/
!models/**/.gitkeep
# Metadata sidecars are small and worth versioning:
!models/**/*_config.json
!models/**/*_metadata.json

# --- Results: keep figures/metrics, drop bulky dumps -----------------------
results/**/*.npy
results/**/*.npz
results/**/*.parquet

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Environments ----------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Testing / linting -----------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Secrets ---------------------------------------------------------------
kaggle.json
.env
*.pem

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Generated logs
results/logs/
